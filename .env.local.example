# Firebase Credentials for JourneySync
# Copy this file to .env.local and replace with your Firebase Project values from Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Web App

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...YourApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-app-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only live flight status. Never prefix these with NEXT_PUBLIC_.
AERODATABOX_API_KEY=your_rapidapi_key_here
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
